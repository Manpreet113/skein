{# CAVA visualizer — merge into ~/.config/cava/config under [color].
   Rendered to: ~/.cache/skein/cava.conf
#}
[color]
background = '{{ theme.background }}'
foreground = '{{ theme.primary }}'
gradient = 1
gradient_count = 4
gradient_color_1 = '{{ theme.background }}'
gradient_color_2 = '{{ theme.primary }}'
gradient_color_3 = '{{ theme.accent }}'
gradient_color_4 = '{{ theme.primary }}'
