{# dunst — dunst has no `include` directive. Consume this as a drop-in:
      ln -s ~/.cache/skein/dunst.conf ~/.config/dunst/dunstrc.d/99-skein.conf
   then `pkill dunst` (it reloads on next notification). Only color keys
   are set here; geometry stays in your dunstrc.
#}
[global]
background = "{{ theme.background }}"
foreground = "{{ theme.text }}"
frame_color = "{{ theme.primary }}"
highlight = "{{ theme.accent }}"

[urgency_low]
background = "{{ theme.surface }}"
foreground = "{{ theme.subtext }}"
frame_color = "{{ theme.surface_variant }}"

[urgency_normal]
background = "{{ theme.background }}"
foreground = "{{ theme.text }}"
frame_color = "{{ theme.primary }}"

[urgency_critical]
background = "{{ theme.background }}"
foreground = "{{ theme.text }}"
frame_color = "{{ theme.error }}"
