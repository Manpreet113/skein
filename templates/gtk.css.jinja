{# GTK CSS color definitions — import in gtk.css or waybar config:
      @import url("/home/.../.cache/skein/gtk.css");
    Also usable directly by Waybar (it supports @define-color).
    Rendered to: ~/.cache/skein/gtk.css
#}
@define-color skein_background {{ theme.background }};
@define-color skein_surface {{ theme.surface }};
@define-color skein_surface_variant {{ theme.surface_variant }};
@define-color skein_primary {{ theme.primary }};
@define-color skein_accent {{ theme.accent }};
@define-color skein_text {{ theme.text }};
@define-color skein_subtext {{ theme.subtext }};
@define-color skein_dim {{ theme.dim }};
@define-color skein_border {{ theme.border }};
@define-color skein_error {{ theme.error }};
@define-color skein_success {{ theme.success }};
@define-color skein_warning {{ theme.warning }};

/* Standard GTK3 theme colors — honoured by most GTK3 apps. */
@define-color theme_bg_color {{ theme.background }};
@define-color theme_fg_color {{ theme.text }};
@define-color theme_base_color {{ theme.surface }};
@define-color theme_text_color {{ theme.text }};
@define-color theme_selected_bg_color {{ theme.primary }};
@define-color theme_selected_fg_color {{ theme.background }};
@define-color theme_tooltip_bg_color {{ theme.surface }};
@define-color theme_tooltip_fg_color {{ theme.text }};
@define-color insensitive_bg_color {{ theme.surface }};
@define-color insensitive_fg_color {{ theme.dim }};
@define-color insensitive_base_color {{ theme.surface }};
@define-color theme_unfocused_bg_color {{ theme.background }};
@define-color theme_unfocused_fg_color {{ theme.subtext }};
@define-color theme_unfocused_base_color {{ theme.surface }};
@define-color theme_unfocused_selected_bg_color {{ theme.surface_variant }};
@define-color borders {{ theme.border }};
@define-color warning_color {{ theme.warning }};
@define-color error_color {{ theme.error }};
@define-color success_color {{ theme.success }};

/* libadwaita / GTK4 palette — honoured by Adwaita-style apps. */
@define-color accent_bg_color {{ theme.primary }};
@define-color accent_fg_color {{ theme.background }};
@define-color accent_color {{ theme.accent }};
@define-color destructive_bg_color {{ theme.error }};
@define-color destructive_fg_color {{ theme.background }};
@define-color destructive_color {{ theme.error }};
@define-color success_bg_color {{ theme.success }};
@define-color success_fg_color {{ theme.background }};
@define-color success_color {{ theme.success }};
@define-color warning_bg_color {{ theme.warning }};
@define-color warning_fg_color {{ theme.background }};
@define-color warning_color {{ theme.warning }};
@define-color error_bg_color {{ theme.error }};
@define-color error_fg_color {{ theme.background }};
@define-color error_color {{ theme.error }};
@define-color window_bg_color {{ theme.background }};
@define-color window_fg_color {{ theme.text }};
@define-color view_bg_color {{ theme.surface }};
@define-color view_fg_color {{ theme.text }};
@define-color headerbar_bg_color {{ theme.surface }};
@define-color headerbar_fg_color {{ theme.text }};
@define-color headerbar_border_color {{ theme.border }};
@define-color headerbar_backdrop_color {{ theme.background }};
@define-color card_bg_color {{ theme.surface }};
@define-color card_fg_color {{ theme.text }};
@define-color dialog_bg_color {{ theme.surface }};
@define-color dialog_fg_color {{ theme.text }};
@define-color popover_bg_color {{ theme.surface }};
