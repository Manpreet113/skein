{# Fish shell 3.x color variables.  Source from ~/.config/fish/config.fish:
     source ~/.cache/skein/fish-theme.fish
   Rendered to: ~/.cache/skein/fish-theme.fish
#}
set -g fish_color_normal {{ theme.text | replace("#", "") }}
set -g fish_color_command {{ theme.primary | replace("#", "") }}
set -g fish_color_keyword {{ theme.accent | replace("#", "") }}
set -g fish_color_param {{ theme.subtext | replace("#", "") }}
set -g fish_color_quote {{ theme.subtext | replace("#", "") }}
set -g fish_color_redirection {{ theme.accent | replace("#", "") }}
set -g fish_color_error {{ theme.error | replace("#", "") }}
set -g fish_color_end {{ theme.primary | replace("#", "") }}
set -g fish_color_comment {{ theme.surface_variant | replace("#", "") }}
set -g fish_color_autosuggestion {{ theme.dim | replace("#", "") }}
set -g fish_color_selection --background={{ theme.surface_variant | replace("#", "") }}
set -g fish_color_search_match --background={{ theme.surface_variant | replace("#", "") }}
set -g fish_color_operator {{ theme.accent | replace("#", "") }}
