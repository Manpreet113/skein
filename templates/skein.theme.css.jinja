/**
 * @name Skein
 * @description Wallpaper-driven Discord theme, regenerated by skein on every theme change.
 * @author skein
 * @version 0.1.0
 */
{# Vencord/Vesktop theme — save the rendered file as `skein.theme.css` in
   the client themes folder (Vencord Settings → Themes → Enable Themes),
   or paste it as an Online Theme. Only long-standing core Discord CSS
   variables are overridden (`--background-*`, `--text-*`, `--brand-*`,
   `--status-*`), so this survives Discord class-name churn.
   Rendered to: ~/.cache/skein/skein.theme.css
#}
:root {
  --background-primary: {{ theme.surface }};
  --background-secondary: {{ theme.surface }};
  --background-secondary-alt: {{ theme.surface_variant }};
  --background-tertiary: {{ theme.background }};
  --background-floating: {{ theme.surface_variant }};
  --background-accent: {{ theme.primary }};
  --channeltextarea-background: {{ theme.surface_variant }};
  --modal-background: {{ theme.surface }};
  --modal-footer-background: {{ theme.background }};
  --home-background: {{ theme.surface }};
  --background-mentioned: color-mix(in srgb, {{ theme.warning }} 12%, transparent);
  --text-normal: {{ theme.text }};
  --text-muted: {{ theme.subtext }};
  --header-primary: {{ theme.text }};
  --header-secondary: {{ theme.subtext }};
  --channels-default: {{ theme.subtext }};
  --interactive-normal: {{ theme.subtext }};
  --interactive-hover: {{ theme.text }};
  --interactive-active: {{ theme.text }};
  --brand-experiment: {{ theme.primary }};
  --brand-experiment-500: {{ theme.primary }};
  --brand-experiment-560: {{ theme.accent }};
  --status-danger: {{ theme.error }};
  --status-warning: {{ theme.warning }};
  --status-positive: {{ theme.success }};
}
