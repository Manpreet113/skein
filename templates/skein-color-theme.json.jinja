{# VS Code color theme — install it by creating an extension folder:
      ~/.vscode/extensions/skein-theme/
        package.json            (contributes.themes → ./skein-color-theme.json)
        skein-color-theme.json  (this file)
   then pick "Skein" via Preferences: Color Theme. The `type` field follows
   the current mode. Rendered to: ~/.cache/skein/skein-color-theme.json
#}
{
  "name": "Skein",
  "type": {{ "\"dark\"" if theme.dark_mode else "\"light\"" }},
  "colors": {
    "foreground": "{{ theme.text }}",
    "descriptionForeground": "{{ theme.subtext }}",
    "errorForeground": "{{ theme.error }}",
    "focusBorder": "{{ theme.primary }}",
    "widget.border": "{{ theme.border }}",
    "selection.background": "{{ theme.primary }}80",
    "editor.background": "{{ theme.background }}",
    "editor.foreground": "{{ theme.text }}",
    "editorCursor.foreground": "{{ theme.primary }}",
    "editor.lineHighlightBackground": "{{ theme.surface_variant }}",
    "editorLineNumber.foreground": "{{ theme.dim }}",
    "editorLineNumber.activeForeground": "{{ theme.text }}",
    "editor.selectionBackground": "{{ theme.primary }}80",
    "editor.inactiveSelectionBackground": "{{ theme.surface_variant }}",
    "editorWidget.background": "{{ theme.surface }}",
    "editorWidget.border": "{{ theme.border }}",
    "sideBar.background": "{{ theme.surface }}",
    "sideBar.foreground": "{{ theme.text }}",
    "sideBarTitle.foreground": "{{ theme.text }}",
    "sideBarSectionHeader.background": "{{ theme.surface_variant }}",
    "activityBar.background": "{{ theme.background }}",
    "activityBar.foreground": "{{ theme.text }}",
    "activityBar.inactiveForeground": "{{ theme.subtext }}",
    "activityBarBadge.background": "{{ theme.primary }}",
    "activityBarBadge.foreground": "{{ theme.background }}",
    "statusBar.background": "{{ theme.surface }}",
    "statusBar.foreground": "{{ theme.text }}",
    "titleBar.activeBackground": "{{ theme.background }}",
    "titleBar.activeForeground": "{{ theme.text }}",
    "tab.activeBackground": "{{ theme.surface }}",
    "tab.inactiveBackground": "{{ theme.background }}",
    "tab.activeForeground": "{{ theme.text }}",
    "tab.inactiveForeground": "{{ theme.subtext }}",
    "tab.border": "{{ theme.border }}",
    "panel.background": "{{ theme.surface }}",
    "panel.border": "{{ theme.border }}",
    "button.background": "{{ theme.primary }}",
    "button.foreground": "{{ theme.background }}",
    "input.background": "{{ theme.surface_variant }}",
    "input.foreground": "{{ theme.text }}",
    "input.border": "{{ theme.border }}",
    "list.activeSelectionBackground": "{{ theme.surface_variant }}",
    "list.hoverBackground": "{{ theme.surface }}",
    "notifications.background": "{{ theme.surface }}",
    "notifications.foreground": "{{ theme.text }}",
    "notifications.border": "{{ theme.border }}",
    "gitDecoration.addedResourceForeground": "{{ theme.success }}",
    "gitDecoration.deletedResourceForeground": "{{ theme.error }}",
    "gitDecoration.modifiedResourceForeground": "{{ theme.warning }}",
    "gitDecoration.untrackedResourceForeground": "{{ theme.accent }}",
    "terminal.background": "{{ theme.background }}",
    "terminal.foreground": "{{ theme.text }}",
    "terminal.ansiBlack": "{{ theme.ansi.black }}",
    "terminal.ansiRed": "{{ theme.ansi.red }}",
    "terminal.ansiGreen": "{{ theme.ansi.green }}",
    "terminal.ansiYellow": "{{ theme.ansi.yellow }}",
    "terminal.ansiBlue": "{{ theme.ansi.blue }}",
    "terminal.ansiMagenta": "{{ theme.ansi.magenta }}",
    "terminal.ansiCyan": "{{ theme.ansi.cyan }}",
    "terminal.ansiWhite": "{{ theme.ansi.white }}",
    "terminal.ansiBrightBlack": "{{ theme.ansi.bright_black }}",
    "terminal.ansiBrightRed": "{{ theme.ansi.bright_red }}",
    "terminal.ansiBrightGreen": "{{ theme.ansi.bright_green }}",
    "terminal.ansiBrightYellow": "{{ theme.ansi.bright_yellow }}",
    "terminal.ansiBrightBlue": "{{ theme.ansi.bright_blue }}",
    "terminal.ansiBrightMagenta": "{{ theme.ansi.bright_magenta }}",
    "terminal.ansiBrightCyan": "{{ theme.ansi.bright_cyan }}",
    "terminal.ansiBrightWhite": "{{ theme.ansi.bright_white }}"
  },
  "tokenColors": [
    { "settings": { "foreground": "{{ theme.text }}" } },
    { "name": "Comment", "scope": "comment", "settings": { "foreground": "{{ theme.dim }}", "fontStyle": "italic" } },
    { "name": "String", "scope": "string", "settings": { "foreground": "{{ theme.success }}" } },
    { "name": "Keyword", "scope": "keyword", "settings": { "foreground": "{{ theme.primary }}" } },
    { "name": "Number", "scope": "constant.numeric", "settings": { "foreground": "{{ theme.warning }}" } },
    { "name": "Boolean", "scope": "constant.language", "settings": { "foreground": "{{ theme.warning }}" } },
    { "name": "Function", "scope": "entity.name.function", "settings": { "foreground": "{{ theme.accent }}" } },
    { "name": "Type", "scope": "entity.name.type", "settings": { "foreground": "{{ theme.accent }}" } },
    { "name": "Variable", "scope": "variable", "settings": { "foreground": "{{ theme.text }}" } },
    { "name": "Operator", "scope": "keyword.operator", "settings": { "foreground": "{{ theme.subtext }}" } },
    { "name": "Punctuation", "scope": "punctuation", "settings": { "foreground": "{{ theme.subtext }}" } }
  ]
}
