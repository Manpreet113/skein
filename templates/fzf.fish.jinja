{# fzf colors for fish. Source from ~/.config/fish/config.fish:
      source ~/.cache/skein/fzf.fish
    Rendered to: ~/.cache/skein/fzf.fish
#}
set -gx FZF_DEFAULT_OPTS "--color=bg:{{ theme.background }},bg+:{{ theme.surface }},fg:{{ theme.text }},fg+:{{ theme.text }},hl:{{ theme.primary }},hl+:{{ theme.accent }},info:{{ theme.dim }},border:{{ theme.border }},prompt:{{ theme.primary }},pointer:{{ theme.accent }},marker:{{ theme.success }},spinner:{{ theme.accent }},header:{{ theme.subtext }},gutter:{{ theme.background }}"
